{
  "name": "stresst",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "assets:fetch": "node scripts/assets/fetch.mjs",
    "assets:process": "node scripts/assets/process.mjs",
    "assets:sounds": "node scripts/assets/sounds.mjs",
    "assets:inspect": "node scripts/assets/inspect.mjs",
    "assets:prepare": "npm run assets:fetch && npm run assets:process && npm run assets:sounds"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.86.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
